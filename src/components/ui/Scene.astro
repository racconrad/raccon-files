---
import type { Scene } from '../../data/portfolio';

interface Props {
  id: Scene;
  class?: string;
}

const { id, class: className } = Astro.props;
---

<section
  id={id}
  data-scene={id}
  aria-labelledby={`${id}-title`}
  class:list={['scene relative px-1 py-6 md:px-3 md:py-8', className]}
>
  <slot />
</section>
