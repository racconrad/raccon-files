---
import Icon from '../Icon.astro';
import DesktopDialog from '../DesktopDialog.astro';
import Action from '../ui/Action.astro';
import TechnologyList from '../ui/TechnologyList.astro';
import type { Locale, Project } from '../../data/portfolio';
import { ui } from '../../data/ui';

interface Props {
  project: Project;
  locale: Locale;
}

const { project, locale } = Astro.props;
const t = ui(locale);
---

<DesktopDialog
  id={`project-${project.id}`}
  title={project.name}
  closeLabel={t.close}
  icon={project.icon}
>
  <span class="kicker">{project.content[locale].context}</span>
  <h2 class="mt-3 mb-6 font-display text-3xl leading-tight text-accent md:text-4xl">
    {project.content[locale].title}
  </h2>
  <p class="text-sm leading-loose text-muted">
    {project.content[locale].description}
  </p>
  <h3 class="mt-7 mb-2 font-medium">{t.contribution}</h3>
  <p class="text-sm leading-loose text-muted">{project.content[locale].role}</p>
  <h3 class="mt-7 mb-3 font-medium">{t.whatItDoes}</h3>
  <ul class="grid list-none gap-3 p-0 text-sm text-muted">
    {project.content[locale].features.map((feature) => (
      <li class="flex items-start gap-3">
        <Icon name="check" size={17} class="mt-1 text-accent" />
        {feature}
      </li>
    ))}
  </ul>
  <h3 class="mt-7 font-medium">{t.builtWith}</h3>
  <TechnologyList items={project.technologies} locale={locale} />
  <div class="flex flex-wrap gap-3">
    {project.url && (
      <Action href={project.url} icon="github" newTab>
        {t.source}
      </Action>
    )}
    {project.demo && (
      <Action href={project.demo} icon="external" newTab>
        {t.demo}
      </Action>
    )}
  </div>
</DesktopDialog>
