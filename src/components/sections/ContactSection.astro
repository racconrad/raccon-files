---
import Avatar from '../art/Avatar.astro';
import { site } from '../../site.config';
import Icon from '../Icon.astro';
import Scene from '../ui/Scene.astro';
import Action from '../ui/Action.astro';
import { profile, type Locale } from '../../data/portfolio';
import { ui } from '../../data/ui';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui(locale);
---

<Scene id="contact">
  <div class="mx-auto grid min-h-full max-w-[1050px] items-center gap-4 px-2 md:grid-cols-[1fr_1.1fr] md:gap-12">
    <div
      class="relative order-2 mx-auto aspect-square w-full max-w-36 md:order-none md:max-w-60"
      aria-hidden="true"
    >
      <Avatar
        class="size-full"
        poses={['phone', 'call', 'phone_lying']}
        label={t.pose}
      />
    </div>
    <div class="contact-copy" data-stagger>
      <h2
        id="contact-title"
        class="font-display text-[clamp(2.5rem,4.6vw,4.125rem)] leading-[1.05] tracking-tight"
      >
        {t.contactTitle}
      </h2>
      <p class="mt-6 max-w-[48ch] text-sm leading-loose text-muted md:text-base">
        {t.contactCopy}
      </p>
      <Action
        href={profile.github}
        icon="github"
        newTab
        pose="call"
        class="mt-7"
      >
        {t.github}
      </Action>
      {site.email && (
        <a
          href={`mailto:${site.email}`}
          class="mt-3 flex items-center gap-2 font-mono text-xs text-accent"
        >
          <Icon name="copy" size={17} />
          {site.email}
        </a>
      )}
      <button
        type="button"
        data-copy-link={profile.github}
        data-pose="alert"
        class="flex items-center gap-2 py-4 text-sm text-accent"
      >
        <Icon name="copy" size={17} />
        <span>{t.copyLink}</span>
      </button>
    </div>
  </div>
</Scene>
