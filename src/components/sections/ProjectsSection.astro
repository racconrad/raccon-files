---
import Icon from '../Icon.astro';
import ProjectPreview from '../ProjectPreview.astro';
import Scene from '../ui/Scene.astro';
import SceneHeading from '../ui/SceneHeading.astro';
import WindowHeader from '../ui/WindowHeader.astro';
import Action from '../ui/Action.astro';
import TechnologyList from '../ui/TechnologyList.astro';
import {
  projects,
  moreProjects,
  defaultProjectId,
  type Locale,
} from '../../data/portfolio';
import { ui } from '../../data/ui';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui(locale);
// Companion raccoon pose when viewing each project.
const projectPose: Record<string, string> = {
  kwallet: 'glasses',
  fox: 'doubt',
  sentinel: 'coding',
  tinywidgets: 'skateboard',
  attention: 'studying',
  glados: 'alert',
};
const pad = (value: number) => String(value).padStart(2, '0');
---

<Scene id="projects">
  <SceneHeading
    id="projects-title"
    title={t.projectsTitle}
    description={t.projectsLead}
  />

  <div class="mx-auto max-w-[1100px]">
    {projects.map((project, index) => (
      <article
        data-broadcast={project.id}
        hidden={project.id !== defaultProjectId}
        class="broadcast retro-window"
      >
        <WindowHeader title={project.name} icon={project.icon} />
        <div class="relative grid gap-6 p-5 md:grid-cols-[1.1fr_1fr] md:gap-8 md:p-6">
          <div class="self-center">
            <span class="kicker">
              {pad(index + 1)} / {pad(projects.length)} ·{' '}
              {project.content[locale].context}
            </span>
            <h3 class="mt-3 font-display text-[clamp(2rem,3.4vw,3.125rem)] leading-[1.05] tracking-tight text-accent">
              {project.content[locale].title}
            </h3>
            <p class="mt-3 max-w-lg text-sm leading-relaxed text-muted md:text-base">
              {project.content[locale].description}
            </p>
            <p class="role-note mt-3 max-w-lg text-sm leading-relaxed">
              <strong>{t.contribution}:</strong> {project.content[locale].role}
            </p>
            <TechnologyList items={project.technologies} locale={locale} />
            <div class="flex flex-wrap items-center gap-x-5 gap-y-3">
              <Action open={`project-${project.id}`}>{t.viewProject}</Action>
              {project.url && (
                <a
                  class="project-link"
                  href={project.url}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <Icon name="github" size={17} />
                  {t.source}
                </a>
              )}
              {project.demo && (
                <a
                  class="project-link"
                  href={project.demo}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <Icon name="external" size={17} />
                  {t.demo}
                </a>
              )}
            </div>
          </div>
          <ProjectPreview project={project} locale={locale} />
        </div>
      </article>
    ))}
  </div>

  <nav
    class="broadcast-selector mt-5 flex items-center justify-center gap-2"
    aria-label={t.chooseProject}
  >
    <button
      type="button"
      class="project-step"
      data-project-step="-1"
      aria-label={t.prevProject}
    >
      <Icon name="back" size={18} />
    </button>
    <div data-stagger class="flex flex-wrap justify-center gap-2">
      {projects.map((project) => (
        <button
          type="button"
          data-project-select={project.id}
          data-pose={projectPose[project.id]}
          aria-pressed={project.id === defaultProjectId ? 'true' : 'false'}
          class="project-tab flex items-center gap-2 border-[length:var(--border)] border-line px-2 py-2 font-mono text-xs text-muted transition-colors duration-200 hover:border-accent hover:text-accent md:px-3 md:text-sm"
        >
          <Icon name={project.icon} size={18} />
          {project.name}
        </button>
      ))}
    </div>
    <button
      type="button"
      class="project-step"
      data-project-step="1"
      aria-label={t.nextProject}
    >
      <Icon name="chevron" size={18} />
    </button>
  </nav>

  <section
    class="more-projects mx-auto mt-6 max-w-[1100px]"
    aria-labelledby="more-projects-title"
  >
    <h3 id="more-projects-title" class="kicker mb-3">
      {t.moreProjects}
    </h3>
    <ul data-stagger class="grid list-none gap-3 p-0 md:grid-cols-3">
      {moreProjects.map((repo) => (
        <li>
          <a href={repo.url} target="_blank" rel="noopener noreferrer">
            <strong>{repo.name}</strong>
            <span>{repo.description[locale]}</span>
            <small>{repo.tech}</small>
            <Icon name="external" size={16} class="more-arrow" />
          </a>
        </li>
      ))}
    </ul>
  </section>
</Scene>
