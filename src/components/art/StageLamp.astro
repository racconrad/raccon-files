---
interface Props {
  right?: boolean;
}

const { right = false } = Astro.props;
---

<div class:list={['stage-lamp', { 'lamp-right': right }]}>
  <svg viewBox="0 0 80 100" fill="none">
    <path d="M40 0v25" stroke="var(--line)" stroke-width="2" />
    <g class="lamp-head">
      <path
        d="M23 28h34v32H23z"
        fill="var(--panel)"
        stroke="var(--accent)"
        stroke-width="2"
      />
      <path
        d="m23 48-9 16h52l-9-16"
        fill="var(--panel)"
        stroke="var(--accent)"
        stroke-width="2"
      />
      <path
        class="lamp-bulb"
        d="M18 64h44"
        stroke="var(--accent)"
        stroke-width="5"
      />
    </g>
  </svg>
</div>
